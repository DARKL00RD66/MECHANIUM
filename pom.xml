<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
 <modelVersion>4.0.0</modelVersion>
 <groupId>dev.mechanium</groupId><artifactId>mechanium-parent</artifactId><version>0.6.0-SNAPSHOT</version><packaging>pom</packaging>
 <name>MECHANIUM</name><description>Motor independente de progressão histórica, tecnologia e indústria.</description>
 <modules><module>mechanium-api</module><module>mechanium-storage</module><module>mechanium-engine</module><module>mechanium-modules</module><module>mechanium-addon-loader</module><module>mechanium-plugin</module></modules>
 <properties>
  <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><maven.compiler.release>21</maven.compiler.release>
  <paper.version>1.21.11-R0.1-SNAPSHOT</paper.version><junit.version>5.12.2</junit.version><sqlite.version>3.54.1.0</sqlite.version>
 </properties>
 <repositories><repository><id>papermc</id><url>https://repo.papermc.io/repository/maven-public/</url></repository></repositories>
 <dependencyManagement><dependencies>
  <dependency><groupId>dev.mechanium</groupId><artifactId>mechanium-api</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>dev.mechanium</groupId><artifactId>mechanium-storage</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>dev.mechanium</groupId><artifactId>mechanium-engine</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>dev.mechanium</groupId><artifactId>mechanium-modules</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>dev.mechanium</groupId><artifactId>mechanium-addon-loader</artifactId><version>${project.version}</version></dependency>
  <dependency><groupId>io.papermc.paper</groupId><artifactId>paper-api</artifactId><version>${paper.version}</version><scope>provided</scope></dependency>
 </dependencies></dependencyManagement>
 <build><pluginManagement><plugins>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-compiler-plugin</artifactId><version>3.14.0</version><configuration><release>21</release><encoding>UTF-8</encoding><proc>none</proc></configuration></plugin>
  <plugin><groupId>org.apache.maven.plugins</groupId><artifactId>maven-surefire-plugin</artifactId><version>3.5.3</version><configuration><useModulePath>false</useModulePath></configuration></plugin>
 </plugins></pluginManagement></build>
</project>